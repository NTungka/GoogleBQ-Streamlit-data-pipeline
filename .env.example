# Copy this file to .env and fill in your actual values. Never commit the real .env file.

# Format: PROJECT_ID:REGION:INSTANCE_NAME  (find it on the Cloud SQL instance's Overview page)
INSTANCE_CONNECTION_NAME=your-project:us-central1:olist-poc

DB_USER=postgres
DB_PASS=your-db-password
DB_NAME=your-database-name
